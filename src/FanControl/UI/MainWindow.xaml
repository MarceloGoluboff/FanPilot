<ui:FluentWindow x:Class="FanControl.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FanControl.UI"
                 Title="FanControl"
                 Width="580" Height="860" MinWidth="480" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/fan.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Segmented control for the three modes. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" Margin="3" Padding="10,8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One settings row: title and description on the left, control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FanControl" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/fan.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,4,20,24">

                <ui:InfoBar Title="Fan control isn't available"
                            Message="{Binding ErrorMessage}"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            IsClosable="False"
                            Severity="Error"
                            Margin="0,0,0,12" />

                <!-- Live readings -->
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,8,0" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,2"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Card Margin="0,10,8,0" Padding="16,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Last 2 minutes" Style="{StaticResource Secondary}" />
                            <StackPanel x:Name="Legend" Orientation="Horizontal" HorizontalAlignment="Right" />
                        </DockPanel>
                        <local:LiveChart x:Name="Chart" Height="130" />
                    </StackPanel>
                </ui:Card>

                <!-- Mode -->
                <TextBlock Text="Mode" Style="{StaticResource SectionHeader}" />
                <Border CornerRadius="8" Margin="0,0,8,0" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        IsEnabled="{Binding IsControlEnabled}">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" IsChecked="{Binding IsAutoMode}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,6,0" />
                                <TextBlock Text="ASUS Auto" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" IsChecked="{Binding IsManualMode}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Options24" Margin="0,0,6,0" />
                                <TextBlock Text="Manual" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" IsChecked="{Binding IsCurveMode}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataLine24" Margin="0,0,6,0" />
                                <TextBlock Text="Curve" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>
                <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Secondary}" Margin="4,8,8,0" />

                <!-- Manual -->
                <ui:Card Margin="0,10,8,0" Padding="16,14" IsEnabled="{Binding IsControlEnabled}"
                         Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding ManualPercent, StringFormat={}{0}%}" />
                            <TextBlock Text="Fan speed" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                        <Slider Margin="0,10,0,4"
                                Minimum="{Binding MinManualPercent}" Maximum="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding ManualPercent}" />
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                               Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding Percent}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Center"
                                                       Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Curve -->
                <ui:Card Margin="0,10,8,0" Padding="12,12" IsEnabled="{Binding IsControlEnabled}"
                         Visibility="{Binding IsCurveMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <local:CurveEditor x:Name="Editor" Height="260" />
                        <ui:Button Content="Reset curve" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,8,0,0"
                                   HorizontalAlignment="Right" Command="{Binding ResetCurveCommand}" />
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" Margin="4,10,8,0" />

                <!-- Settings -->
                <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />
                <ui:Card Margin="0,0,8,0" Padding="16,8">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Tray icon at sign-in" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="Fan control starts with Windows either way; this adds the tray icon when you sign in." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OpenAtSignIn}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Close to tray" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="The close button hides the window. Exit from the tray icon." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Thermal override" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="In Manual and Curve modes, force 100% at this CPU temperature." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsControlEnabled}"
                                      ItemsSource="{Binding OverrideTemps}" SelectedItem="{Binding OverrideTemp}"
                                      ItemStringFormat="{}{0} °C" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox Grid.Column="1" MinWidth="110"
                                      ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <TextBlock Margin="4,14,8,0" Style="{StaticResource Secondary}"
                           Text="Uses ASUS's AsusWinIO64 driver library, the same one MyASUS Fan Diagnosis uses. Based on Karmel0x/AsusFanControl." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
