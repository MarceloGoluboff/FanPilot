<ui:FluentWindow x:Class="FanPilot.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:FanPilot.UI"
                 Title="FanPilot"
                 Width="600" Height="880" MinWidth="500" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/fan.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Segmented control for the three modes. -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="5" Margin="3" Padding="10,8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One settings row: title and description on the left, control on the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="FanPilot" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/fan.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,4,20,24">

                <ui:InfoBar Title="Fan control isn't available"
                            Message="{Binding ErrorMessage}"
                            IsOpen="{Binding HasError, Mode=OneWay}"
                            IsClosable="False" Severity="Error" Margin="0,0,8,12" />

                <ui:InfoBar Title="Another fan app is running"
                            Message="{Binding ConflictMessage}"
                            IsOpen="{Binding HasConflict, Mode=OneWay}"
                            IsClosable="False" Severity="Warning" Margin="0,0,8,12" />

                <ui:InfoBar Title="This laptop changed since fan setup"
                            Message="The model, BIOS or ASUS driver is different from when fan setup ran. Run it again from Settings so the minimum speed is right."
                            IsOpen="{Binding FanSetupStale, Mode=OneWay}"
                            IsClosable="False" Severity="Warning" Margin="0,0,8,12" />

                <!-- First-launch fan setup prompt -->
                <ui:Card Margin="0,0,8,12" Padding="16,14"
                         Visibility="{Binding ShowFanSetupPrompt, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Set up your fans" FontWeight="SemiBold" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10"
                                   Text="FanPilot measures how slowly your fans can safely spin and how fast ASUS runs them at idle. It takes about a minute and a half, and the fans will speed up and slow down while it runs. Close heavy apps first: it needs the CPU below 70 °C. Until then, FanPilot never goes below 30%." />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Run fan setup" Appearance="Primary" Command="{Binding StartFanSetupCommand}" />
                            <ui:Button Content="Not now" Margin="8,0,0,0" Command="{Binding DismissFanSetupCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Fan setup progress -->
                <ui:Card Margin="0,0,8,12" Padding="16,14"
                         Visibility="{Binding IsCalibrating, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelFanSetupCommand}" />
                            <TextBlock Text="Fan setup is running" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                        <ProgressBar Margin="0,10,0,6" Height="4" Maximum="100" Value="{Binding FanSetupPercent, Mode=OneWay}" />
                        <TextBlock Text="{Binding FanSetupStage}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </ui:Card>

                <ui:InfoBar Title="Fan setup"
                            Message="{Binding FanSetupMessage}"
                            IsOpen="{Binding HasFanSetupMessage, Mode=OneWay}"
                            IsClosable="True" Severity="Informational" Margin="0,0,8,12" />

                <!-- Live readings -->
                <ItemsControl ItemsSource="{Binding Stats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding DataContext.StatsColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,8,8" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" />
                                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Card Margin="0,2,8,0" Padding="16,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Last 2 minutes" Style="{StaticResource Secondary}" />
                            <WrapPanel x:Name="Legend" Orientation="Horizontal" HorizontalAlignment="Right" />
                        </DockPanel>
                        <local:LiveChart x:Name="Chart" Height="130" />
                    </StackPanel>
                </ui:Card>

                <!-- Mode -->
                <TextBlock Text="Mode" Style="{StaticResource SectionHeader}" />
                <Border CornerRadius="8" Margin="0,0,8,0" BorderThickness="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        IsEnabled="{Binding IsControlEnabled}">
                    <UniformGrid Rows="1">
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" IsChecked="{Binding IsAutoMode}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" Margin="0,0,6,0" />
                                <TextBlock Text="ASUS Auto" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" IsChecked="{Binding IsManualMode}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Options24" Margin="0,0,6,0" />
                                <TextBlock Text="Manual" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource SegmentButton}" GroupName="Mode" IsChecked="{Binding IsCurveMode}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DataLine24" Margin="0,0,6,0" />
                                <TextBlock Text="Curve" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                </Border>
                <TextBlock Text="{Binding ModeDescription}" Style="{StaticResource Secondary}" Margin="4,8,8,0" />

                <!-- Manual -->
                <ui:Card Margin="0,10,8,0" Padding="16,14" IsEnabled="{Binding IsControlEnabled}"
                         Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="{Binding ManualPercent, StringFormat={}{0}%}" />
                            <TextBlock Text="Fan speed" VerticalAlignment="Center" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                        <Slider Margin="0,10,0,4"
                                Minimum="{Binding Floor}" Maximum="100"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding ManualPercent}" />
                        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ui:Button Margin="0,0,6,0" HorizontalAlignment="Stretch"
                                               Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding Percent}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Center"
                                                       Style="{StaticResource Secondary}" />
                                        </StackPanel>
                                    </ui:Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Curve -->
                <ui:Card Margin="0,10,8,0" Padding="12,12" IsEnabled="{Binding IsControlEnabled}"
                         Visibility="{Binding IsCurveMode, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <local:CurveEditor x:Name="Editor" Height="260" />
                        <ui:Button Content="Reset curve" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,8,0,0"
                                   HorizontalAlignment="Right" Command="{Binding ResetCurveCommand}" />
                    </StackPanel>
                </ui:Card>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" Margin="4,10,8,0" />

                <!-- Settings -->
                <TextBlock Text="Settings" Style="{StaticResource SectionHeader}" />
                <ui:Card Margin="0,0,8,0" Padding="16,8">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Fan setup" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{Binding FanSetupSummary}" Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="{Binding FanSetupButtonText}"
                                       Command="{Binding StartFanSetupCommand}" IsEnabled="{Binding IsControlEnabled}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="CPU thermal override" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="In Manual and Curve modes, force 100% at this CPU temperature." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsControlEnabled}"
                                      ItemsSource="{Binding OverrideTemps}" SelectedItem="{Binding OverrideTemp}"
                                      ItemStringFormat="{}{0} °C" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="GPU thermal override" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Force 100% at this GPU temperature. A sleeping GPU reports nothing and is never woken to check." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                                      IsEnabled="{Binding IsControlEnabled}"
                                      ItemsSource="{Binding GpuOverrideTemps}" SelectedItem="{Binding GpuOverrideTemp}"
                                      ItemStringFormat="{}{0} °C" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Curve follows the GPU too" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="The curve uses whichever of CPU and GPU is hotter." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CurveUsesGpu}" IsEnabled="{Binding IsControlEnabled}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Tray icon at sign-in" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Fan control runs as a service either way; this adds the tray icon when you sign in." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding TrayAtSignIn}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Close to tray" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="The close button hides the window. Exit from the tray icon." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding CloseToTray}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Theme" VerticalAlignment="Center" Style="{StaticResource RowTitle}" />
                            <ComboBox Grid.Column="1" MinWidth="110"
                                      ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />
                        </Grid>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Diagnostics" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="Copies your laptop model, driver versions, fan setup results and recent log to the clipboard, for a bug report." Style="{StaticResource Secondary}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" VerticalAlignment="Center" Content="Copy diagnostics"
                                       Command="{Binding CopyDiagnosticsCommand}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <TextBlock Margin="4,14,8,0" Style="{StaticResource Secondary}">
                    <!-- Both runs on one line: a line break between them renders as a space before the period. -->
                    <Run Text="{Binding VersionText, Mode=OneWay}" /><Run Text=". Uses ASUS's AsusWinIO64 library from the ASUS System Control Interface driver. Not affiliated with ASUS." />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
